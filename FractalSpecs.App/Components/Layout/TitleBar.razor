@using FractalSpecs.App.Services
@inject IWindowHost WindowHost

@if (WindowHost.IsDesktop)
{
    <div class="custom-title-bar">
        <div class="title-bar-drag-area">
            <span class="ms-3 fw-bold text-light" style="font-size: 0.85rem;">FractalSpecs Desktop</span>
        </div>
        <div class="title-bar-controls">
            <button class="title-btn minimize" @onclick="WindowHost.Minimize" aria-label="Minimize">
                <svg width="10" height="1" viewBox="0 0 10 1"><path d="M0,0 H10 V1 H0 Z" fill="currentColor"/></svg>
            </button>
            <button class="title-btn maximize" @onclick="WindowHost.Maximize" aria-label="Maximize">
                <svg width="10" height="10" viewBox="0 0 10 10"><path d="M0,0 H10 V10 H0 Z M1,1 V9 H9 V1 Z" fill="currentColor"/></svg>
            </button>
            <button class="title-btn close" @onclick="WindowHost.Close" aria-label="Close">
                <svg width="10" height="10" viewBox="0 0 10 10"><path d="M0,1 L1,0 L5,4 L9,0 L10,1 L6,5 L10,9 L9,10 L5,6 L1,10 L0,9 L4,5 Z" fill="currentColor"/></svg>
            </button>
        </div>
    </div>
}
